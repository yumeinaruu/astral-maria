{
  "name": "astral-maria",
  "productName": "Astral Maria",
  "version": "0.1.0",
  "description": "A local-first desktop API client.",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --mac --dir",
    "package:e2e": "npm run build && electron-builder --mac --dir --config electron-builder.e2e.yml",
    "package:dmg": "npm run build && electron-builder --mac dmg"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.52.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  },
  "dependencies": {
    "undici": "8.12.3"
  }
}
